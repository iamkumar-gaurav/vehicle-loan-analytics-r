
# ==========================================
# Vehicle Loan Analytics Using R
# Git Ignore Configuration
# ==========================================

# R History and Session Data
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata

# RStudio Configuration
.Rproj.user/

# R Build Files
*-Ex.R
/*.tar.gz
/*.Rcheck/

# Environment and Credentials
.Renviron
.env
.env.*
!.env.example
.httr-oauth

# R Markdown and Quarto Cache
*_cache/
/cache/
*.utf8.md
*.knit.md
.quarto/

# Generated Data
data/processed/*
data/exceptions/*

# Generated Reports and Outputs
outputs/*
reports/*.html
reports/*.pdf

# Logs
logs/*

# Preserve Empty Directories
!data/processed/.gitkeep
!data/exceptions/.gitkeep
!outputs/.gitkeep
!logs/.gitkeep

# Temporary Files
*.tmp
*.log
*~
.DS_Store
Thumbs.db

# Translation Temporary Files
po/*~

# RStudio Connect
rsconnect/
